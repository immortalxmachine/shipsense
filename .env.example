# ===========================================================================
# ShipSense environment variables — copy to .env and fill in.
# NEVER commit the real .env file (it is in .gitignore).
# ===========================================================================

# ---- PostgreSQL ----
POSTGRES_DB=shipsense
POSTGRES_USER=shipsense
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Java Spring Boot backend ----
# JDBC URL the Spring app uses to reach Postgres.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/shipsense
SPRING_DATASOURCE_USERNAME=shipsense
SPRING_DATASOURCE_PASSWORD=changeme_local_only
# Base URL of the Python ML service the backend calls for delay predictions.
ML_SERVICE_URL=http://localhost:8000
SERVER_PORT=8080

# ---- Python ML service (FastAPI) ----
ML_SERVICE_PORT=8000
# Where the trained model + metrics are written/read.
MODEL_DIR=models

# ---- React frontend (Vite) ----
# Must be prefixed with VITE_ to be exposed to the browser bundle.
VITE_API_BASE_URL=http://localhost:8080
